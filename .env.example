# Copie este arquivo para ".env.local" (no seu computador) e preencha os valores.
# No Netlify, cadastre as mesmas variáveis em: Site configuration → Environment variables.

# ── Sanity (painel de conteúdo) ───────────────────────────────────────────────
# ID do projeto: sanity.io/manage → seu projeto → aparece logo abaixo do nome.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Nome do dataset (o banco de conteúdo). Use "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Token de leitura (papel "Viewer"), usado só para a pré-visualização de rascunhos.
# sanity.io/manage → projeto → API → Tokens → Add API token → Viewer. Nunca compartilhe.
SANITY_API_READ_TOKEN=

# Segredo do webhook que atualiza o site quando você publica no painel.
# Invente uma frase longa (ex.: gere em https://www.uuidgenerator.net) e use a MESMA
# no webhook do Sanity (sanity.io/manage → projeto → API → Webhooks).
SANITY_REVALIDATE_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
# Endereço público do site, sem barra no final (ex.: https://blanzo.com.br).
# Usado no sitemap, nos links de compartilhamento e no SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Formulário de contato (opcional) ──────────────────────────────────────────
# Chave de acesso do Web3Forms (grátis: web3forms.com). Sem ela, o formulário não aparece.
NEXT_PUBLIC_WEB3FORMS_KEY=
