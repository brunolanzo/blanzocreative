{
  "name": "blanzo-creative-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Site portfólio da Blanzo Creative Studio (Next.js + Sanity).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "sanity exec scripts/seed/index.ts --with-user-token",
    "placeholders": "node scripts/placeholders/generate.mjs",
    "typegen": "sanity schema extract --path=./src/sanity/schema.json --enforce-required-fields --force && sanity typegen generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/locale-pt-br": "^1.1.37",
    "@sanity/orderable-document-list": "^2.0.26",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
    "next": "^16.3.8",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.18.0",
    "sanity-plugin-mux-input": "^5.1.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "ffmpeg-static": "^5.3.0",
    "lexorank": "^1.0.5",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
